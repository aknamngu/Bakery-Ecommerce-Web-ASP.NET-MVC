@model List<SweetAndSavoryBakery.Models.CartItem>
@{
    ViewBag.Title = "Giỏ hàng của bạn";
}

<h2 class="text-center fw-bold mt-4">🛒 Giỏ hàng của bạn</h2>

@if (Model == null || !Model.Any())
{
    <p class="text-center text-muted mt-4">Chưa có sản phẩm nào trong giỏ hàng 😢</p>
}
else
{
    <table class="table table-striped mt-4">
        <thead>
            <tr>
                <th>Ảnh</th>
                <th>Tên sản phẩm</th>
                <th>Giá</th>
                <th>Số lượng</th>
                <th>Tổng</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <img src="@item.ImageUrl" style="width: 80px; height: 80px; object-fit: cover;" />
                    </td>
                    <td>@item.Name</td>
                    <td>@String.Format("{0:N0} VNĐ", item.Price)</td>
                    <td>@item.Quantity</td>
                    <td>@String.Format("{0:N0} VNĐ", item.Price * item.Quantity)</td>
                    <td>
                        <a href="@Url.Action("Remove", "Cart", new { id = item.ProductId })"
                                         class="btn btn-outline-danger btn-sm">❌ Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="text-end me-4 mt-5">
        <h5 class="text-muted">Tổng tiền hàng: <b>@String.Format("{0:N0} VNĐ", ViewBag.SubTotal)</b></h5>
        @{
            // Ép kiểu an toàn (dùng 0m nếu giá trị ViewBag bị null)
            decimal subTotal = (decimal)(ViewBag.SubTotal ?? 0m);
            decimal freeshipThreshold = (decimal)(ViewBag.FREESHIP_THRESHOLD ?? 0m);
            decimal missingAmount = freeshipThreshold - subTotal;
        }
        @* LOGIC HIỂN THỊ ƯU ĐÃI FREESHIP *@
        @if (ViewBag.IsFreeShip)
        {
            <h5 class="text-success fw-bold">
                Phí vận chuyển: <span class="badge bg-success">FREESHIP</span>
            </h5>
        }
        else
        {
            <h5 class="text-danger">
                Phí vận chuyển: <b>@String.Format("{0:N0} VNĐ", ViewBag.ShippingFee)</b>
            </h5>

            @* HIỂN THỊ SỐ TIỀN CÒN THIẾU *@
            if (missingAmount > 0)
            {
                <p class="text-muted small">
                    (Mua thêm **@String.Format("{0:N0} VNĐ", missingAmount)** để được Freeship)
                </p>
            }
        }

        <h4 class="mt-3 text-pink fw-bold">
            TỔNG THANH TOÁN: <b>@String.Format("{0:N0} VNĐ", ViewBag.FinalTotal)</b>
        </h4>

        <div class="text-end mt-3">
            <a href="@Url.Action("Checkout", "Cart")" class="btn btn-pink px-4">💳 Thanh toán</a>
        </div>
    </div>
}