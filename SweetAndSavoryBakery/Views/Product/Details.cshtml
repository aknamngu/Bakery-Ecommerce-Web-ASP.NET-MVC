@model SweetAndSavoryBakery.Models.Product
@{
    ViewBag.Title = "Chi tiết sản phẩm";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-5 text-center">
            <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded shadow-sm" />
        </div>

        <div class="col-md-7">
            <h2 class="fw-bold text-pink">@Model.Name</h2>
            <p class="lead text-muted">@Model.Category.Name</p>
            <p class="fs-2 fw-bold text-danger">@String.Format("{0:N0} VNĐ", @Model.Price)</p>

            <h4 class="mt-4" style="color: #d63384;">Mô tả sản phẩm:</h4>
            <p class="fs-6 mt-2">@Model.Description</p>

            @* Nếu còn hàng *@
            @if (Model.Stock > 0)
            {
                using (Html.BeginForm("Add", "Cart", FormMethod.Post, new { @class = "d-inline" }))
                {
                    @Html.Hidden("id", Model.Id)
                    <label for="quantity">Số lượng:</label>
                    <input type="number" name="quantity" value="1" min="1" max="@Model.Stock" style="width: 70px;" class="form-control d-inline me-2" />
                    <button type="submit" class="btn btn-pink">🛒 Thêm vào giỏ hàng</button>
                }
            }
            else
            {
                <button class="btn btn-secondary" disabled>Đã hết hàng</button>
            }

            <a href="/Product" class="btn btn-outline-secondary ms-2">⬅️ Quay lại</a>

            @* 🔹 Chỉ hiện phần này nếu là Admin *@
            @if (User.IsInRole("Admin"))
            {
                <hr />
                <div class="mt-3">
                    <h5 class="text-info fw-bold">🛠 Quản lý kho (chỉ Admin)</h5>
                    @using (Html.BeginForm("UpdateStock", "Product", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("id", Model.Id)
                        <label for="newStock">Cập nhật số lượng trong kho:</label>
                        <input type="number" name="newStock" min="0" value="@Model.Stock" class="form-control d-inline" style="width:100px;" />
                        <button type="submit" class="btn btn-warning btn-sm ms-2">Cập nhật</button>
                    }

                </div>
            }
        </div>
    </div>
</div>
